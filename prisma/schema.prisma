// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

// 사용자
model User {
  id                  String           @id @default(uuid())
  studentId           String           @unique @map("student_id")
  passwordHash        String           @map("password_hash")
  name                String
  department          String
  phone               String
  referralCode        String?          @map("referral_code")
  points              Int              @default(0)
  membershipFeeStatus MembershipStatus @default(unknown) @map("membership_fee_status")
  joinedAt            DateTime         @default(now()) @map("joined_at")
  isAdmin             Boolean          @default(false) @map("is_admin")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  kakaoId             String?          @map("kakao_id")
  role                String           @default("user")

  pointHistory PointHistory[]
  rentals      Rental[]

  @@map("users")
}

enum MembershipStatus {
  paid
  not_paid
  unknown
}

// 이벤트
model Event {
  id           String   @id @default(uuid())
  title        String
  location     String
  date         DateTime
  endDate      DateTime? @map("end_date")
  content      String
  imageUrls    String[] @default([]) @map("image_urls")
  instagramUrl String?  @map("instagram_url")
  points       Int      @default(0)
  postDate     DateTime @map("post_date")
  postEndDate  DateTime @map("post_end_date")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("events")
}

// 포인트 히스토리
model PointHistory {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  points    Int
  reason    String
  date      DateTime @default(now())
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("point_history")
}

// 대여 물품
model RentalItem {
  id          String   @id @default(uuid())
  name        String
  category    String
  totalStock  Int      @map("total_stock")
  available   Int
  imageUrl    String?  @map("image_url")
  emoji       String?
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rentals Rental[]

  @@map("rental_items")
}

// 대여
model Rental {
  id                 String       @id @default(uuid())
  userId             String       @map("user_id")
  itemId             String       @map("item_id")
  quantity           Int
  rentalDate         DateTime     @default(now()) @map("rental_date")
  returnDate         DateTime?    @map("return_date")
  expectedReturnDate DateTime     @map("expected_return_date")
  status             RentalStatus @default(active)
  notes              String?
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  item RentalItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("rentals")
}

enum RentalStatus {
  active
  returned
}

// 설정
model Settings {
  id               String   @id @default(uuid())
  organizationName String   @map("organization_name")
  logoMain         String?  @map("logo_main")
  instagram        String?
  primaryColor     String   @default("#3B82F6") @map("primary_color")
  secondaryColor   String   @default("#10B981") @map("secondary_color")
  contactPhone     String   @default("") @map("contact_phone")
  contactPerson    String   @default("") @map("contact_person")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// 등급 설정
model GradeConfig {
  id            String    @id @default(uuid())
  name          String
  type          GradeType @default(ABSOLUTE_POINTS)
  minPoints     Int       @default(0) @map("min_points")
  maxPoints     Int?      @map("max_points")
  percentileMin Float?    @map("percentile_min")
  percentileMax Float?    @map("percentile_max")
  emoji         String
  badgeImage    String?   @map("badge_image")
  color         String    @default("#000000")
  bgColor       String    @default("#FFFFFF") @map("bg_color")
  benefit       String    @default("")
  orderIndex    Int       @default(0) @map("order_index")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("grade_configs")
}

enum GradeType {
  ABSOLUTE_POINTS
  PERCENTILE
}
